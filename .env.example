# Supabase (remote only — shared by the team)
NEXT_PUBLIC_SUPABASE_URL=https://cyvoxtijyntxixeyghnm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key

# Google Cloud Vertex AI (Gemini 2.5 Flash — GCP credits, no GEMINI_API_KEY)
GOOGLE_CLOUD_PROJECT=twinly-496507
GOOGLE_CLOUD_LOCATION=us-central1

# Credentials — use ONE of these (inline JSON is best for Vercel/deploy):
# Full service account JSON on a SINGLE line (run: jq -c . secrets/gcp-service-account.json)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or base64-encoded JSON (run: base64 -i secrets/gcp-service-account.json | tr -d '\n')
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Or local file path only (do not paste JSON into this variable):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# OpenAI (text formatting, predictions, recommendations)
OPENAI_API_KEY=

# WeatherAPI (server-side only)
WEATHERAPI_KEY=

# App URL (used for QR links in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
